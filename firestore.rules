rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /payments/{id} {
      // العميل (من غير دخول) يقدر يسجل طلب جديد "بانتظار التأكيد" بس، ومش يقرا حاجة
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.amount is int
        && request.resource.data.amount > 0 && request.resource.data.amount <= 10000000
        && request.resource.data.method in ['instapay','vodafone','card']
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.phone.matches('^01[0-9]{9}$')
        && request.resource.data.note.size() <= 200
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly(['amount','method','name','phone','note','status','createdAt']);

      // الحسابات المسموحة (الإيميلات بحروف صغيرة). ضيف باقي الشركاء هنا بنفس الشكل
      allow read, update, create: if request.auth != null
        && request.auth.token.email in ['ammaresmohamed100@gmail.com', 'mohamed@wallet.local', 'mohemed@wallet.local'];
    }
  }
}
